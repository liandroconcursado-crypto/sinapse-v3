# Banco local/deploy
DATABASE_URL=postgresql://sinapse:sinapse@localhost:5432/sinapse

# Auth — nomes finais dependem da ADR e da biblioteca escolhida
AUTH_SECRET=replace-with-a-long-random-secret
APP_URL=http://localhost:3000

# IA — provider fake deve funcionar sem credenciais
AI_PROVIDER=fake
AI_API_KEY=
AI_MODEL=

# Arquivos — local no desenvolvimento; objeto externo somente após ADR
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=.data/uploads

# Observabilidade
LOG_LEVEL=info
